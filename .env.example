# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payment Gateway (Paystack Integration)
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""

# Resend API Key for Email Verification
RESEND_API_KEY=""

# SMTP Mail Configurations (optional - will fall back to console logging if not configured)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"

# Client / Frontend Environment Variables
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_APP_NAME=
VITE_ADMIN_EMAIL=

# Client / Frontend URL (optional, defaults to Netlify and localhost)
CLIENT_URL=""
